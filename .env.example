# KBase 环境变量样例 —— 只列变量名与说明，**任何真实值都不得写进本文件**。
#
# 用法：复制成 .env（已被 .gitignore 忽略）再填值，docker compose 会自动读取：
#   cp .env.example .env && vi .env
#   docker compose -f docker-compose.lite.yml up -d --build
# 或在启动命令前直接给变量（见各 compose 文件头部的用法示例）。
#
# 校验：scripts/check_env_example.py 会核对"compose 与 config/*.yaml 里引用的
# 全部变量名"是否都在本文件出现（CI 的 lint job 会跑），漏一个即门禁红。

# ---------------------------------------------------------------------------
# 一、必填（不设起不来 / 有安全后果）
# ---------------------------------------------------------------------------

# 会话 JWT 签名密钥。生产必须显式设置：不设则每次重建容器都会生成新密钥，
# 所有已登录会话立即失效。生成示例：openssl rand -hex 32
KBASE_SECRET_KEY=

# 首启 admin 账号的密码。不设则随机生成并只打印一次到容器日志。
KBASE_ADMIN_PASSWORD=

# PostgreSQL 密码（仅 standard 档）。compose 的 postgres 服务与应用容器共用
# 这一个变量：应用侧由 config/kbase.standard.yaml 的 db.password_env 指名，
# 启动时渲染进 db.url（kbase/config.py:resolve_db_url）。
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# 二、LLM / OCR 网关密钥（按需，用哪个填哪个；变量名与 config/*.yaml 的
#     api_key_env 一一对应。也可以改走管理端「Provider」页面配置，DB 里的
#     值优先于环境变量）
# ---------------------------------------------------------------------------

# 智谱：默认 LLM（glm-5-turbo）+ GLM-OCR 共用
ZHIPU_API_KEY=
# 通义千问 / DashScope（standard 档的生成与向量模型都用它）
DASHSCOPE_API_KEY=
# DeepSeek
DEEPSEEK_API_KEY=
# OpenAI
OPENAI_API_KEY=
# 月之暗面 Kimi（kimi-k3 等）
MOONSHOT_API_KEY=
# iruidong 中转网关（config/kbase.yaml 的 4 个 iruidong-* provider 共用）
IRUIDONG_API_KEY=

# Qdrant 鉴权（仅云端托管 Qdrant 需要；compose 内的 Qdrant 未开鉴权）
QDRANT_API_KEY=

# ---------------------------------------------------------------------------
# 三、运行时行为（可选，留空即用默认）
# ---------------------------------------------------------------------------

# bge-m3 / reranker 权重的下载源；国内网络建议 https://hf-mirror.com
HF_ENDPOINT=

# 首启把权重下完之后建议设 1：跳过启动期的 HF 在线校验（镜像站故障会卡启动，
# 1.95 演示服实测 hf-mirror 504 让容器一直 unhealthy）
HF_HUB_OFFLINE=

# 许可证文件路径（离线续期时指到挂载进来的 license.json；不设用默认位置）
KBASE_LICENSE_FILE=

# 文本层 PDF 解析器：留空=auto（opendataloader，缺 Java 自动回退 markitdown）；
# 可显式设 markitdown 强制走旧解析器
KBASE_PDF_PARSER=

# MCP Server 侧（只有跑 kbase_mcp 时用得上）
# 访问 KBase API 的地址与凭据
KBASE_API_URL=
KBASE_API_KEY=
# MCP 工具 description 里追加的 filters 受控词表（如客户行业/数据实体枚举）
KBASE_MCP_FILTERS_DOC=
KBASE_MCP_TOKEN=
